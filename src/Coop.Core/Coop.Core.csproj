<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Game-agnostic layer (ARCHITECTURE.md §9). No TaleWorlds.* reference is
    permitted here, ever — that is the whole point of this assembly's
    existence. Bannerlord-specific adapters live in Coop.GameInterface.
  -->

  <PropertyGroup>
    <!--
      net472 is the real target — this assembly ships inside the game next to
      Coop.GameInterface and must be loadable by a .NET Framework 4.7.2 process.
      net8.0 is added purely so `dotnet test` can run Coop.Core.Tests natively
      in CI (Linux runners don't have Mono, which net472 test execution needs)
      — same source, same behavior, just a second build target for testing.
    -->
    <TargetFrameworks>net472;net8.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Coop.Core</RootNamespace>
    <Nullable>disable</Nullable>
    <Deterministic>true</Deterministic>
  </PropertyGroup>

  <ItemGroup Condition="'$(TargetFramework)' == 'net472'">
    <!-- ReadOnlySpan<T> (ICoopTransport) isn't in the net472 BCL on its own — this is the
         standard Microsoft compatibility package for it, not an extra runtime dependency
         beyond what .NET Framework itself already ships. -->
    <PackageReference Include="System.Memory" Version="4.5.5" />
  </ItemGroup>

</Project>
